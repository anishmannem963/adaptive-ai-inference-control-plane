APP_ENV=development
MOCK_PROVIDERS_ENABLED=true
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_MODEL_ALIAS=ollama-local
OLLAMA_NOMINAL_LATENCY_MS=800
OLLAMA_QUALITY_SCORE=0.75
AWS_BEDROCK_ENABLED=false
AWS_REGION=us-east-1
AWS_BEDROCK_MODEL_ID=
AWS_BEDROCK_MODEL_ALIAS=bedrock-primary
AWS_BEDROCK_INPUT_COST_PER_MILLION_TOKENS_USD=0
AWS_BEDROCK_OUTPUT_COST_PER_MILLION_TOKENS_USD=0
AWS_BEDROCK_NOMINAL_LATENCY_MS=1200
AWS_BEDROCK_QUALITY_SCORE=0.90
AWS_SESSION_BUDGET_USD=0
CACHE_ENABLED=true
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300
IDEMPOTENCY_TTL_SECONDS=86400
OTEL_SERVICE_NAME=adaptive-ai-inference-control-plane
OTEL_EXPORTER_OTLP_ENDPOINT=
TELEMETRY_RECENT_EVENTS_LIMIT=100
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8888
