APP_ENV=development
AWS_BEDROCK_ENABLED=false
AWS_REGION=us-east-1
AWS_BEDROCK_MODEL_ID=
AWS_SESSION_BUDGET_USD=0
CACHE_ENABLED=true
REDIS_URL=redis://localhost:6379/0
